{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowOnlyProtectedWorkshopEnvironmentFromRepository",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::450567357211:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:xujk0217/taishin-smart-report:environment:workshop-foundation"
        }
      }
    }
  ]
}
