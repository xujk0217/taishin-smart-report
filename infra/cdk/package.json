{
  "name": "@smart-report/infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint ok'",
    "test": "vitest run",
    "cdk": "cdk",
    "synth": "cdk synth",
    "synth:ui": "cdk synth --app 'npx tsx src/ui-only-app.ts' SmartReportWorkshopUiStack",
    "deploy": "cdk deploy --all",
    "deploy:ui": "cdk deploy --app 'npx tsx src/ui-only-app.ts' SmartReportWorkshopUiStack"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "3.1101.0",
    "@aws-sdk/client-dynamodb": "3.1101.0",
    "@aws-sdk/client-ecs": "3.1101.0",
    "@aws-sdk/client-s3": "3.1101.0",
    "@aws-sdk/client-sfn": "3.1101.0",
    "@aws-sdk/s3-presigned-post": "3.1101.0",
    "@aws-sdk/s3-request-presigner": "3.1101.0",
    "@smart-report/contracts": "file:../../packages/contracts",
    "aws-cdk-lib": "2.263.0",
    "constructs": "10.7.1"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "aws-cdk": "2.1133.0",
    "tsx": "4.19.4",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
