{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VerifyWorkshopDeploymentIdentity",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadRequiredCdkContext",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAvailabilityZones"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadCdkBootstrapVersion",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter"
      ],
      "Resource": "arn:aws:ssm:us-east-1:450567357211:parameter/cdk-bootstrap/hnb659fds/version"
    },
    {
      "Sid": "AssumeOnlyWorkshopCdkBootstrapRoles",
      "Effect": "Allow",
      "Action": [
        "sts:AssumeRole"
      ],
      "Resource": [
        "arn:aws:iam::450567357211:role/cdk-hnb659fds-lookup-role-450567357211-us-east-1",
        "arn:aws:iam::450567357211:role/cdk-hnb659fds-deploy-role-450567357211-us-east-1",
        "arn:aws:iam::450567357211:role/cdk-hnb659fds-file-publishing-role-450567357211-us-east-1",
        "arn:aws:iam::450567357211:role/cdk-hnb659fds-image-publishing-role-450567357211-us-east-1"
      ]
    }
  ]
}
