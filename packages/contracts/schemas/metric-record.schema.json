    "computedValue": { "type": "number" },
    "unit": { "type": "string", "enum": ["percent", "million_twd", "count", "rank", "ratio"] },
    "period": { "type": "string" },
    "entity": { "type": "string" },
    "rank": { "type": ["integer", "null"] },
    "rankTotal": { "type": ["integer", "null"] },
